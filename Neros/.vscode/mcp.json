{
	"servers": {
		"AzureDevOps": {
			"type": "stdio",
			"command": "npx",
			"args": [
				"-y",
				"@azure-devops/mcp",
				"fivepaqco",
				"--authentication",
				"envvar"
			],
			"env": {
				"ADO_MCP_AUTH_TOKEN": "${env:AZURE_DEVOPS_PAT}"
			}
		},
		"postman": {
			"type": "http",
			"url": "https://mcp.postman.com/minimal",
			"headers": {
				"Authorization": "Bearer ${env:POSTMAN_MCP_KEY}"
			}
		},
		"microsoft-learn": {
			"type": "http",
			"url": "https://learn.microsoft.com/api/mcp"
		},
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "Bearer ${env:GITHUB_PERSONAL_ACCESS_TOKEN}"
			}
		}
	}
}
