@inject IStringLocalizer<TextosComunes> C

@if (Abierto)
{
    <div class="n-modal-root">
        <button type="button" class="n-modal-scrim" aria-label="@C["Modal.Cerrar"]" @onclick="Cerrar"></button>
        <div class="n-modal-panel n-enter @ClaseAncho" role="dialog" aria-modal="true" aria-labelledby="@_tituloId">
            <header class="n-modal-header">
                <h2 id="@_tituloId">@Titulo</h2>
                <button type="button" class="n-icon-button" aria-label="@C["Modal.Cerrar"]" @onclick="Cerrar">
                    <Icono Nombre="x" />
                </button>
            </header>
            <div class="n-modal-body">@ChildContent</div>
            @if (Pie is not null)
            {
                <footer class="n-modal-footer">@Pie</footer>
            }
        </div>
    </div>
}

@code {
    private readonly string _tituloId = $"modal-{Guid.NewGuid():N}";

    [Parameter] public bool Abierto { get; set; }
    [Parameter] public EventCallback<bool> AbiertoChanged { get; set; }
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Pie { get; set; }
    [Parameter] public bool AnchoGrande { get; set; } = true;
    [Parameter] public bool AnchoExtra { get; set; }

    private string ClaseAncho => AnchoExtra ? "n-modal-panel-xl" : AnchoGrande ? "n-modal-panel-lg" : "";

    private async Task Cerrar() => await AbiertoChanged.InvokeAsync(false);
}
