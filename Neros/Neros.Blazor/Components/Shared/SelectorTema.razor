@inject IStringLocalizer<TextosComunes> C

<div class="n-theme" role="group" aria-label="@C["Tema.Grupo"]">
    <button type="button" data-theme-value="system" aria-label="@C["Tema.Sistema"]" title="@C["Tema.Sistema"]" aria-pressed="true"><Icono Nombre="monitor" /></button>
    <button type="button" data-theme-value="light" aria-label="@C["Tema.Claro"]" title="@C["Tema.Claro"]" aria-pressed="false"><Icono Nombre="sun" /></button>
    <button type="button" data-theme-value="dark" aria-label="@C["Tema.Oscuro"]" title="@C["Tema.Oscuro"]" aria-pressed="false"><Icono Nombre="moon" /></button>
</div>
