@inherits LayoutComponentBase
@inject IHttpContextAccessor ContextAccessor
@inject NavigationManager Navigation
@inject IStringLocalizer<TextosComunes> C

<a class="n-skip" href="#contenido">@C["Comun.IrAlContenido"]</a>
<div class="n-shell">
    <aside class="n-sidebar">
        <NavMenu />
    </aside>
    <div class="n-main">
        <header class="n-topbar">
            <Marca Clase="n-topbar-brand" SoloSimbolo="true" />
            <nav class="n-breadcrumb" aria-label="@C["Layout.Ubicacion"]">
                <a href="/empresas" title="@C["Layout.CambiarEmpresa"]"><Icono Nombre="building-2" /><span>@(NombreEmpresa ?? C["Layout.SeleccionarEmpresa"])</span></a>
                @if (ClaveSeccion is not null)
                {
                    <Icono Nombre="chevron-right" />
                    <span aria-current="page">@C[ClaveSeccion]</span>
                }
            </nav>
            <div class="n-topbar-actions">
                <Preferencias />
                <form method="post" action="/sesion/salir" data-busy-form data-enhance="false">
                    <AntiforgeryToken />
                    <button class="n-button n-ghost n-logout" type="submit" title="@C["Layout.CerrarSesion"]" aria-label="@C["Layout.CerrarSesion"]"><Icono Nombre="log-out" /><span>@C["Layout.Salir"]</span></button>
                </form>
            </div>
        </header>
        <main class="n-content" id="contenido">
            @Body
        </main>
        <footer class="n-workspace-footer"><span>Neros ERP</span><span>@C["Layout.SesionDe", Usuario.Identity?.Name ?? string.Empty]</span></footer>
    </div>
</div>
<div id="blazor-error-ui" data-nosnippet>
    @C["Comun.ErrorActualizar"]
    <a href="." class="reload">@C["Comun.Recargar"]</a>
</div>

@code {
    private ClaimsPrincipal Usuario => ContextAccessor.HttpContext?.User ?? new ClaimsPrincipal();
    private string? NombreEmpresa => Usuario.FindFirstValue(EndpointsSesion.NombreEmpresaClaim);
    private string? ClaveSeccion => Presentacion.ClaveSeccion(Navigation.ToBaseRelativePath(Navigation.Uri));
}
