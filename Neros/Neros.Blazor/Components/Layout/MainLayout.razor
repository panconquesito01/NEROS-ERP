@inherits LayoutComponentBase
@inject IHttpContextAccessor ContextAccessor

<a class="n-skip" href="#contenido">Ir al contenido</a>
<div class="n-shell">
    <aside class="n-sidebar">
        <NavMenu />
    </aside>
    <div class="n-main">
        <header class="n-topbar">
            <span class="n-topbar-context"><Icono Nombre="panel-left" /><span>@(Usuario.FindFirstValue(EndpointsSesion.NombreEmpresaClaim) ?? "Espacio de trabajo")</span></span>
            <div class="n-topbar-actions">
                <SelectorTema />
                <form method="post" action="/sesion/salir" data-busy-form data-enhance="false">
                    <AntiforgeryToken />
                    <button class="n-icon-button" type="submit" title="Cerrar sesión" aria-label="Cerrar sesión"><Icono Nombre="log-out" /></button>
                </form>
            </div>
        </header>
        <main class="n-content" id="contenido">
            @Body
        </main>
        <footer class="n-workspace-footer"><span>Neros ERP</span><span>Tu espacio de trabajo</span></footer>
    </div>
</div>
<div id="blazor-error-ui" data-nosnippet>
    No se pudo actualizar la página.
    <a href="." class="reload">Recargar</a>
</div>

@code {
    private ClaimsPrincipal Usuario => ContextAccessor.HttpContext?.User ?? new ClaimsPrincipal();
}
