@inject IHttpContextAccessor ContextAccessor

<a class="n-brand n-sidebar-brand" href="/home" aria-label="Neros ERP, inicio"><span class="n-brand-mark"><span class="n-brand-emblem" aria-hidden="true"></span></span><span>neros<span class="n-brand-erp">ERP</span></span></a>
<a class="n-company-switch" href="/empresas">
    <Icono Nombre="building-2" />
    <span><small>Empresa activa</small><strong>@(Usuario.FindFirstValue(EndpointsSesion.NombreEmpresaClaim) ?? "Seleccionar empresa")</strong></span>
    <Icono Nombre="chevrons-up-down" />
</a>
<nav class="n-navigation" aria-label="Navegación principal">
    <NavLink class="n-nav-link" href="home" Match="NavLinkMatch.All"><Icono Nombre="house" />Inicio</NavLink>
    <NavLink class="n-nav-link" href="empresas"><Icono Nombre="building-2" />Mis empresas</NavLink>
</nav>
<div class="n-sidebar-user">
    <span class="n-avatar"><Icono Nombre="user-round" /></span>
    <span><strong>@Usuario.Identity?.Name</strong><small>@Usuario.FindFirstValue(ClaimTypes.Email)</small></span>
</div>

@code {
    private ClaimsPrincipal Usuario => ContextAccessor.HttpContext?.User ?? new ClaimsPrincipal();
}
