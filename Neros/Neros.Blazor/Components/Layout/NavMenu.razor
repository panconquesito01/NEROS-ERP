@inject IHttpContextAccessor ContextAccessor
@inject IStringLocalizer<TextosComunes> C

<Marca Clase="n-sidebar-brand" />
<a class="n-company-switch" href="/empresas" title="@C["Layout.CambiarEmpresa"]">
    @if (NombreEmpresa is null)
    {
        <span class="n-company-switch-mark"><Icono Nombre="building-2" /></span>
        <span><small>@C["Nav.SinEmpresa"]</small><strong>@C["Layout.SeleccionarEmpresa"]</strong></span>
    }
    else
    {
        <span class="n-company-switch-mark">@Presentacion.Iniciales(NombreEmpresa)</span>
        <span><small>@C["Nav.EmpresaActiva"]</small><strong>@NombreEmpresa</strong></span>
    }
    <Icono Nombre="chevrons-up-down" />
</a>
<nav class="n-navigation" aria-label="@C["Nav.Principal"]">
    <span class="n-nav-label" aria-hidden="true">@C["Nav.EspacioTrabajo"]</span>
    <NavLink class="n-nav-link" href="home" Match="NavLinkMatch.All"><Icono Nombre="house" /><span>@C["Seccion.Inicio"]</span></NavLink>
    <NavLink class="n-nav-link" href="empresas"><Icono Nombre="building-2" /><span>@C["Seccion.Empresas"]</span></NavLink>
</nav>
<div class="n-sidebar-user">
    <span class="n-avatar" aria-hidden="true">@Presentacion.Iniciales(Usuario.Identity?.Name)</span>
    <span><strong>@Usuario.Identity?.Name</strong><small title="@Usuario.FindFirstValue(ClaimTypes.Email)">@Usuario.FindFirstValue(ClaimTypes.Email)</small></span>
</div>

@code {
    private ClaimsPrincipal Usuario => ContextAccessor.HttpContext?.User ?? new ClaimsPrincipal();
    private string? NombreEmpresa => Usuario.FindFirstValue(EndpointsSesion.NombreEmpresaClaim);
}
