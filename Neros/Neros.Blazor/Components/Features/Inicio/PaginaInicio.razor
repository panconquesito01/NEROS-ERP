@page "/home"
@rendermode InteractiveServer
@attribute [Authorize]
@inject ClienteNeros Cliente
@inject IHttpContextAccessor ContextAccessor
@inject NavigationManager Navigation
@inject IStringLocalizer<TextosInicio> T
@inject ServicioUiModales UiModales

<PageTitle>@T["Titulo"]</PageTitle>

<section class="n-page n-enter">
    @if (Estado == "salida")
    {
        <Aviso>@T["ErrorSalida"]</Aviso>
    }
    @if (cargando)
    {
        <EstadoCargando>@T["Cargando"]</EstadoCargando>
    }
    else if (error is not null)
    {
        <Aviso ReintentarHref="/home">@error</Aviso>
    }
    else if (inicio is not null)
    {
        <div class="n-dashboard-v2">
            <EncabezadoInicio NombreUsuario="@ContextAccessor.HttpContext?.User.Identity?.Name"
                              Empresa="inicio.Empresa"
                              AbrirModulos="AbrirModulosAsync" />
            <AccesosRapidosInicio AbrirModulos="AbrirModulosAsync" />
            <TarjetasModulos />
            <div class="n-dashboard-split">
                <TarjetaCuentaSeguridad DebeCambiarClave="@DebeCambiarClave"
                                        UltimoAccesoUtc="@UltimoAccesoUtc"
                                        SesionesAbiertas="@sesionesAbiertas" />
                <ActividadReciente Actividad="inicio.Actividad" />
            </div>
            @if (AdministradorGlobal)
            {
                <PanelAdministracionPlataforma />
            }
        </div>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "estado")] public string? Estado { get; set; }
    private InicioEmpresa? inicio;
    private string? error;
    private bool cargando = true;
    private int sesionesAbiertas;
    private ClaimsPrincipal Usuario => ContextAccessor.HttpContext!.User;
    private bool DebeCambiarClave => Usuario.HasClaim(EndpointsSesion.DebeCambiarClaveClaim, "true");
    private bool AdministradorGlobal => Usuario.HasClaim(ClaimTypes.Role, "AdministradorGlobal");
    private DateTime? UltimoAccesoUtc => inicio?.Actividad.OrderByDescending(actividad => actividad.Fecha).FirstOrDefault()?.Fecha.UtcDateTime;

    protected override async Task OnInitializedAsync()
    {
        var context = ContextAccessor.HttpContext!;
        if (!Guid.TryParse(context.User.FindFirstValue(EndpointsSesion.EmpresaClaim), out var empresaId))
        {
            Navigation.NavigateTo("/empresas", forceLoad: true);
            return;
        }
        var token = context.User.FindFirstValue(EndpointsSesion.TokenClaim)!;
        try
        {
            var tInicio = Cliente.InicioAsync(token, empresaId, context.RequestAborted);
            var tSesiones = Cliente.SesionesAsync(token, context.RequestAborted);
            await Task.WhenAll(tInicio, tSesiones);
            inicio = await tInicio;
            sesionesAbiertas = (await tSesiones).Count;
            if (inicio is null)
            {
                Navigation.NavigateTo("/empresas?estado=permiso", forceLoad: true);
            }
        }
        catch (HttpRequestException)
        {
            error = T["ErrorCarga"];
        }
        catch (TaskCanceledException)
        {
            error = T["ErrorTiempo"];
        }
        finally
        {
            cargando = false;
        }
    }

    private Task AbrirModulosAsync() { UiModales.AbrirModulos(); return Task.CompletedTask; }
}
