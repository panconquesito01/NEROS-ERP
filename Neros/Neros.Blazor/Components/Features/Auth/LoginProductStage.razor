<section class="product-stage" aria-label="Neros, centro operativo empresarial">
    <div class="stage-copy">
        <p class="stage-kicker"><span aria-hidden="true"></span> Control operativo / Tiempo real</p>
        <h2>Todo tu negocio.<br /><em>Una sola lectura.</em></h2>
        <p class="stage-description">Ventas, inventario y finanzas conectados para que cada decisión empiece con información clara.</p>
    </div>

    <div class="command-viewport" aria-label="Vista previa del centro operativo de Neros">
        <div class="viewport-bar">
            <div class="viewport-dots" aria-hidden="true"><span></span><span></span><span></span></div>
            <span>Centro operativo</span>
            <span class="live-indicator"><i aria-hidden="true"></i> Sincronizado</span>
        </div>

        <div class="command-shell">
            <aside class="command-rail" aria-hidden="true">
                <strong>N</strong>
                <span class="rail-item active"><iconify-icon icon="lucide:layout-dashboard"></iconify-icon></span>
                <span class="rail-item"><iconify-icon icon="lucide:receipt-text"></iconify-icon></span>
                <span class="rail-item"><iconify-icon icon="lucide:boxes"></iconify-icon></span>
                <span class="rail-item"><iconify-icon icon="lucide:wallet-cards"></iconify-icon></span>
                <span class="rail-spacer"></span>
                <span class="rail-avatar">DR</span>
            </aside>

            <div class="command-content">
                <header class="command-header">
                    <div>
                        <span>Resumen general</span>
                        <strong>Buenos dias, David.</strong>
                    </div>
                    <span class="command-date">12 AGO · CO</span>
                </header>

                <div class="metric-grid">
                    <article class="primary-metric">
                        <span>Ventas netas</span>
                        <strong>$18,45M</strong>
                        <small><b>↗ 12,4%</b> frente a ayer</small>
                    </article>
                    <article>
                        <span>Pedidos</span>
                        <strong>128</strong>
                        <small>31 por despachar</small>
                    </article>
                    <article>
                        <span>Stock crítico</span>
                        <strong>17</strong>
                        <small>4 requieren accion</small>
                    </article>
                </div>

                <div class="insight-grid">
                    <article class="chart-panel">
                        <header><span>Flujo comercial</span><small>Ultimos 7 dias</small></header>
                        <div class="chart-value"><strong>$74,8M</strong><span>+8,2%</span></div>
                        <div class="chart-area" aria-hidden="true">
                            <svg viewBox="0 0 500 130" preserveAspectRatio="none">
                                <defs>
                                    <linearGradient id="areaFill" x1="0" x2="0" y1="0" y2="1">
                                        <stop offset="0%" stop-color="#39d9c3" stop-opacity=".36" />
                                        <stop offset="100%" stop-color="#39d9c3" stop-opacity="0" />
                                    </linearGradient>
                                </defs>
                                <path class="area" d="M0,110 C55,92 70,104 112,72 C158,37 186,81 232,55 C280,28 309,62 350,36 C391,10 434,38 500,12 L500,130 L0,130 Z" />
                                <path class="line" d="M0,110 C55,92 70,104 112,72 C158,37 186,81 232,55 C280,28 309,62 350,36 C391,10 434,38 500,12" />
                            </svg>
                            <span class="chart-marker"></span>
                        </div>
                    </article>

                    <article class="activity-panel">
                        <header><span>Actividad</span><i aria-hidden="true"></i></header>
                        <div class="activity-item"><span class="activity-icon teal"><iconify-icon icon="lucide:badge-check"></iconify-icon></span><p><strong>Pago conciliado</strong><small>Factura FV-2841</small></p><time>Ahora</time></div>
                        <div class="activity-item"><span class="activity-icon amber"><iconify-icon icon="lucide:package-check"></iconify-icon></span><p><strong>Pedido listo</strong><small>Salida de bodega</small></p><time>8m</time></div>
                        <div class="activity-item"><span class="activity-icon blue"><iconify-icon icon="lucide:circle-dollar-sign"></iconify-icon></span><p><strong>Venta registrada</strong><small>Punto de venta 02</small></p><time>14m</time></div>
                    </article>
                </div>
            </div>
        </div>
    </div>

    <div class="module-dock" aria-label="Modulos principales">
        @foreach (var module in Modules)
        {
            <LoginModuleTile Module="module" />
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<LoginModule> Modules { get; set; } = [];
}
