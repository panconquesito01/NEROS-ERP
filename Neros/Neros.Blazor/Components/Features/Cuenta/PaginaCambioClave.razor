@page "/cuenta/clave"
@attribute [Authorize]
@inject IHttpContextAccessor ContextAccessor
@inject IStringLocalizer<TextosCuenta> T
@inject IStringLocalizer<TextosComunes> C

<PageTitle>@T["Clave.Titulo"]</PageTitle>

<section class="n-page n-enter n-narrow" aria-labelledby="clave-titulo">
    <header class="n-page-heading">
        <div>
            <h1 id="clave-titulo">@T["Clave.Encabezado"]</h1>
            <p>@T["Clave.Subtitulo"]</p>
        </div>
    </header>
    @if (Estado == "cambiada")
    {
        <Aviso Tipo="TipoAviso.Exito">@T["Clave.Cambiada"]</Aviso>
        <a class="n-button n-primary" href="@Continuar"><span>@T["Clave.Continuar"]</span><Icono Nombre="arrow-right" /></a>
    }
    else
    {
        @if (DebeCambiarClave)
        {
            <Aviso Tipo="TipoAviso.Informacion">@T["Clave.Obligatoria"]</Aviso>
        }
        @if (Error is not null)
        {
            <Aviso>@Error</Aviso>
        }
        <form class="n-form-card" method="post" action="/sesion/clave" data-busy-form data-enhance="false">
            <AntiforgeryToken />
            @Campo("clave-actual", "ClaveActual", T["Clave.Actual"].Value, "current-password", 1)
            @Campo("clave-nueva", "ClaveNueva", T["Clave.Nueva"].Value, "new-password", 12, "clave-requisitos")
            <p class="n-field-hint" id="clave-requisitos">@T["Clave.Requisitos"]</p>
            @Campo("clave-confirmacion", "Confirmacion", T["Clave.Confirmacion"].Value, "new-password", 12)
            <button class="n-button n-primary" type="submit">
                <Icono Nombre="key-round" />
                <span data-idle-label>@T["Clave.Guardar"]</span>
                <span data-busy-label hidden>@T["Clave.Guardando"]</span>
            </button>
        </form>
    }
</section>

@code {
    private static readonly HashSet<string> Errores = ["clave_actual", "misma_clave", "politica", "bloqueado", "confirmacion", "longitud", "intentos", "servicio", "datos"];

    [SupplyParameterFromQuery(Name = "estado")] public string? Estado { get; set; }

    private ClaimsPrincipal Usuario => ContextAccessor.HttpContext?.User ?? new ClaimsPrincipal();
    private bool DebeCambiarClave => Usuario.HasClaim(EndpointsSesion.DebeCambiarClaveClaim, "true");
    private string Continuar => Usuario.HasClaim(EndpointsSesion.LegalPendienteClaim, "true") ? EndpointsSesion.RutaAceptacionLegal
        : Usuario.HasClaim(claim => claim.Type == EndpointsSesion.EmpresaClaim) ? "/home" : "/empresas";
    private string? Error => Estado is not null && Errores.Contains(Estado) ? T[$"Clave.Error.{Estado}"].Value : null;

    private RenderFragment Campo(string id, string nombre, string etiqueta, string autocompletar, int minimo, string? descripcion = null) => @<div class="n-field">
        <label for="@id">@etiqueta</label>
        <div class="n-input-icon">
            <Icono Nombre="lock-keyhole" />
            <input id="@id" name="@nombre" type="password" autocomplete="@autocompletar" required minlength="@minimo" maxlength="128" aria-describedby="@descripcion" />
            <button class="n-password-toggle" type="button" data-password-toggle="@id" aria-label="@C["Js.MostrarClave"]" aria-pressed="false" title="@C["Js.MostrarClave"]"><Icono Nombre="eye" /></button>
        </div>
    </div>;
}
