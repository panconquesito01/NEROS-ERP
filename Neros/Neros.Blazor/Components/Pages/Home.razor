@page "/home"
@attribute [Authorize]
@inject ClienteNeros Cliente
@inject IHttpContextAccessor ContextAccessor
@inject NavigationManager Navigation

<PageTitle>Inicio | Neros ERP</PageTitle>

<section class="n-page n-enter">
    <header class="n-page-heading">
        <div><h1>Hola, @ContextAccessor.HttpContext?.User.Identity?.Name.</h1><p>Todo listo para continuar.</p></div>
        <time class="n-date" datetime="@DateTimeOffset.UtcNow.ToString("O")" data-local-date="long">@DateTime.UtcNow.ToString("dd/MM/yyyy")</time>
    </header>
    @if (Estado == "salida")
    {
        <div class="n-notice n-error" role="alert"><Icono Nombre="circle-alert" /><p>No se pudo cerrar la sesión en el servidor. Vuelve a pulsar Cerrar sesión.</p></div>
    }
    @if (error is not null)
    {
        <div class="n-notice n-error" role="alert"><Icono Nombre="circle-alert" /><p>@error</p><a href="/home">Reintentar</a></div>
    }
    else if (inicio is not null)
    {
        <section class="n-company-context" aria-label="Empresa activa">
            <span class="n-company-monogram">@inicio.Empresa.Codigo[..Math.Min(2, inicio.Empresa.Codigo.Length)]</span>
            <div class="n-context-name"><span class="n-active-badge">Empresa activa</span><h2>@inicio.Empresa.Nombre</h2><p>@inicio.Empresa.Codigo · @inicio.Empresa.Identificacion</p></div>
            <div class="n-context-role"><span>Tu rol</span><strong>@inicio.Empresa.Rol</strong></div>
            <a class="n-button n-secondary" href="/empresas"><Icono Nombre="arrow-left-right" />Cambiar empresa</a>
        </section>
        <section class="n-shortcuts" aria-labelledby="accesos-titulo">
            <h2 id="accesos-titulo">A un paso</h2>
            <div class="n-shortcut-grid">
                <a class="n-shortcut" href="/empresas"><span class="n-shortcut-icon"><Icono Nombre="building-2" /></span><span><strong>Mis empresas</strong><small>Empresas y roles asignados</small></span><Icono Nombre="arrow-up-right" /></a>
                <a class="n-shortcut" href="#actividad"><span class="n-shortcut-icon n-coral"><Icono Nombre="history" /></span><span><strong>Mi actividad</strong><small>Accesos a esta empresa</small></span><Icono Nombre="arrow-down" /></a>
            </div>
        </section>
        <section class="n-activity" id="actividad" aria-labelledby="actividad-titulo">
            <header class="n-section-heading">
                <h2 id="actividad-titulo">Mi actividad reciente</h2>
                <form method="get" action="/home#actividad" data-enhance="false">
                    <input type="hidden" name="actualizar" value="@Guid.NewGuid().ToString("N")" />
                    <button class="n-icon-button" type="submit" title="Actualizar actividad" aria-label="Actualizar actividad"><Icono Nombre="refresh-cw" /></button>
                </form>
            </header>
            @if (inicio.Actividad.Count == 0)
            {
                <div class="n-empty"><Icono Nombre="history" /><p>Aún no hay actividad registrada para ti en esta empresa.</p></div>
            }
            else
            {
                <div class="n-table-container"><table class="n-table"><caption class="sr-only">Últimos accesos de tu cuenta a la empresa activa</caption><thead><tr><th scope="col">Actividad</th><th scope="col">Fecha y hora</th></tr></thead><tbody>
                    @foreach (var actividad in inicio.Actividad)
                    {
                        <tr><td><span class="n-table-action"><Icono Nombre="log-in" />@actividad.Accion</span></td><td><time datetime="@actividad.Fecha.ToString("O")" data-local-date="short">@actividad.Fecha.ToString("dd/MM/yyyy HH:mm 'UTC'")</time></td></tr>
                    }
                </tbody></table></div>
            }
        </section>
        <details class="n-roadmap">
            <summary><span><Icono Nombre="grid-2x2" />Módulos del ERP</span><span class="n-roadmap-label">En preparación <Icono Nombre="chevron-down" /></span></summary>
            <ul class="n-module-list">
                <li><Icono Nombre="receipt-text" /><strong>Ventas</strong><span>En preparación</span></li>
                <li><Icono Nombre="package" /><strong>Inventario</strong><span>En preparación</span></li>
                <li><Icono Nombre="wallet" /><strong>Finanzas</strong><span>En preparación</span></li>
                <li><Icono Nombre="chart-no-axes-combined" /><strong>Consolidación gerencial</strong><span>En preparación</span></li>
            </ul>
        </details>
    }
</section>

@code {
    [SupplyParameterFromQuery(Name = "estado")] public string? Estado { get; set; }
    private InicioEmpresa? inicio;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        var context = ContextAccessor.HttpContext!;
        if (!Guid.TryParse(context.User.FindFirstValue(EndpointsSesion.EmpresaClaim), out var empresaId))
        {
            Navigation.NavigateTo("/empresas", forceLoad: true);
            return;
        }
        try
        {
            inicio = await Cliente.InicioAsync(context.User.FindFirstValue(EndpointsSesion.TokenClaim)!, empresaId, context.RequestAborted);
            if (inicio is null)
            {
                Navigation.NavigateTo("/empresas?estado=permiso", forceLoad: true);
            }
        }
        catch (HttpRequestException)
        {
            error = "No pudimos cargar tu espacio de trabajo. Inténtalo nuevamente en unos minutos.";
        }
        catch (TaskCanceledException)
        {
            error = "La consulta tardó más de lo esperado. Vuelve a intentar.";
        }
    }
}
