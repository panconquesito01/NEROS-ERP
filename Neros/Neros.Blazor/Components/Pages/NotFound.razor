@page "/not-found"
@layout MainLayout

<PageTitle>Pagina no encontrada | Neros</PageTitle>

<section class="rounded-lg border border-slate-200 bg-white p-8 shadow-sm">
	<p class="text-xs font-semibold uppercase text-teal-700">404</p>
	<h1 class="mt-2 text-2xl font-semibold text-slate-950">Pagina no encontrada</h1>
	<p class="mt-3 max-w-xl text-sm leading-6 text-slate-600">
		La ruta solicitada no existe o todavia no esta disponible en Neros.
	</p>
	<a class="mt-6 inline-flex h-10 items-center rounded-md bg-neros-teal px-4 text-sm font-semibold text-white no-underline hover:bg-teal-800 hover:text-white" href="/">
		Volver al inicio
	</a>
</section>