@page "/"
@page "/login"
@layout AuthLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]

<PageTitle>Acceso | Neros ERP</PageTitle>

<div class="n-login">
    <neros-red class="n-login-network" aria-hidden="true"></neros-red>
    <header class="n-login-header">
        <a class="n-brand" href="/login" aria-label="Neros ERP"><span class="n-brand-mark"><span class="n-brand-emblem" aria-hidden="true"></span></span><span>neros<span class="n-brand-erp">ERP</span></span></a>
        <SelectorTema />
    </header>
    <div class="n-login-content">
        <section class="n-access n-enter" aria-labelledby="acceso-titulo">
            <header class="n-access-heading">
                <div class="n-access-title">
                    <h1 id="acceso-titulo">Bienvenido a <span>Neros.</span></h1>
                    <span class="n-access-symbol" aria-hidden="true"><Icono Nombre="log-in" /></span>
                </div>
                <p class="n-access-intro">Ingresa a tu espacio de trabajo.</p>
            </header>
            <div class="n-notice @(Estado == "salida" ? "n-success" : "n-error")" role="@(Estado == "salida" ? "status" : "alert")" hidden="@(Mensaje is null)" data-login-result
                 data-credenciales="@MensajeAcceso("credenciales")" data-datos="@MensajeAcceso("datos")"
                 data-conexion="@MensajeAcceso("conexion")" data-servicio="@MensajeAcceso("servicio")"
                 data-intentos="@MensajeAcceso("intentos")" data-solicitud="@MensajeAcceso("solicitud")" data-red="@MensajeAcceso("red")"><Icono Nombre="info" /><p>@Mensaje</p></div>
            <form method="post" action="/sesion/entrar" class="n-login-form" data-login-form data-busy-form data-enhance="false">
                <AntiforgeryToken />
                <div class="n-field">
                    <label for="correo">Correo electrónico</label>
                    <div class="n-input-icon"><Icono Nombre="mail" /><input id="correo" name="Correo" type="email" autocomplete="username" inputmode="email" autocapitalize="none" placeholder="nombre@empresa.com" required maxlength="256" spellcheck="false" /></div>
                </div>
                <div class="n-field">
                    <label for="clave">Contraseña</label>
                    <div class="n-input-icon"><Icono Nombre="lock-keyhole" /><input id="clave" name="Clave" type="password" autocomplete="current-password" placeholder="Tu contraseña" required maxlength="128" aria-describedby="caps-lock" /><button class="n-password-toggle" type="button" data-password-toggle="clave" aria-label="Mostrar contraseña" aria-pressed="false" title="Mostrar contraseña"><Icono Nombre="eye" /></button></div>
                    <p id="caps-lock" class="n-caps-warning" role="status" hidden>Bloqueo de mayúsculas activado.</p>
                </div>
                <div class="n-login-options">
                    <label class="n-checkbox"><input type="checkbox" data-remember-email /> Recordar mi correo</label>
                    <label class="n-checkbox"><input type="checkbox" name="Recordarme" value="true" /> Mantener sesión</label>
                </div>
                <button class="n-button n-primary n-login-submit" type="submit"><span data-idle-label>Entrar a Neros</span><span data-busy-label hidden role="status">Verificando acceso...</span><span class="n-submit-symbol"><Icono Nombre="arrow-right" /></span></button>
            </form>
            <details class="n-access-help">
                <summary>¿Necesitas recuperar el acceso?</summary>
                <p>Contacta al administrador de tu empresa para revisar tu cuenta. Si realizaste varios intentos, espera 15 minutos antes de volver a entrar.</p>
            </details>
            <div class="n-access-bottom"><Icono Nombre="building-2" /><span>Un acceso. Tus empresas.</span></div>
        </section>
        <div class="n-login-discover">
            <a href="#modulos"><span>Explorar módulos</span><Icono Nombre="arrow-down" /></a>
            <button class="n-icon-button" type="button" data-network-toggle aria-label="Pausar animación" title="Pausar animación" aria-pressed="false" hidden><Icono Nombre="pause" /></button>
        </div>
    </div>
    <section id="modulos" class="n-login-catalog" aria-labelledby="modulos-titulo">
        <div class="n-catalog-inner">
            <header class="n-catalog-heading">
                <h2 id="modulos-titulo">Tu negocio, conectado.</h2>
                <p>Hoy, tus empresas en un mismo acceso. El siguiente paso: conectar tu operación comercial y financiera.</p>
            </header>
            <div class="n-catalog-list">
                <details class="n-catalog-module">
                    <summary><Icono Nombre="building-2" /><span><strong>Acceso multiempresa</strong><small>Tus empresas. Un mismo lugar.</small><span class="n-module-available">Disponible</span></span><Icono Nombre="chevron-down" /></summary>
                    <p>Entra con tu cuenta, elige una empresa autorizada y cambia de contexto sin cerrar sesión. Consulta tu actividad de acceso reciente.</p>
                </details>
                <details class="n-catalog-module">
                    <summary><Icono Nombre="receipt-text" /><span><strong>Ventas y facturación</strong><small>Del primer contacto al cobro.</small><span class="n-module-planned">En preparación</span></span><Icono Nombre="chevron-down" /></summary>
                    <p>Proyectamos conectar cotizaciones, pedidos, entregas y devoluciones. La facturación fiscal dependerá del país y de su habilitación.</p>
                </details>
                <details class="n-catalog-module">
                    <summary><Icono Nombre="package" /><span><strong>Inventarios</strong><small>Cada producto, en su lugar.</small><span class="n-module-planned">En preparación</span></span><Icono Nombre="chevron-down" /></summary>
                    <p>Productos, bodegas, movimientos y conteos previstos para dar visibilidad a las existencias y acompañar las decisiones de abastecimiento.</p>
                </details>
                <details class="n-catalog-module">
                    <summary><Icono Nombre="arrow-left-right" /><span><strong>Compras y proveedores</strong><small>Abastecer con más contexto.</small><span class="n-module-planned">En preparación</span></span><Icono Nombre="chevron-down" /></summary>
                    <p>El alcance propuesto incluye solicitudes, órdenes, recepciones y devoluciones, con seguimiento del proveedor y de cada compra.</p>
                </details>
                <details class="n-catalog-module">
                    <summary><Icono Nombre="wallet" /><span><strong>Finanzas y contabilidad</strong><small>Una visión más clara del dinero.</small><span class="n-module-planned">En preparación</span></span><Icono Nombre="chevron-down" /></summary>
                    <p>Cartera, cuentas por pagar, tesorería y contabilidad forman parte de la evolución prevista, con controles por empresa y periodo.</p>
                </details>
                <details class="n-catalog-module">
                    <summary><Icono Nombre="chart-no-axes-combined" /><span><strong>Gestión e informes</strong><small>Información para decidir.</small><span class="n-module-planned">En preparación</span></span><Icono Nombre="chevron-down" /></summary>
                    <p>Informes operativos y gerenciales previstos para relacionar la actividad con los resultados. La consolidación entre empresas aún no está disponible.</p>
                </details>
            </div>
            <p class="n-catalog-note">Los módulos en preparación aún no están disponibles y no tienen una fecha de lanzamiento confirmada.</p>
        </div>
    </section>
    <footer class="n-login-footer"><span>Neros ERP</span><span>Un espacio para cada empresa.</span></footer>
</div>

@code {
    [SupplyParameterFromQuery(Name = "estado")] public string? Estado { get; set; }
    private string? Mensaje => MensajeAcceso(Estado);
    private static string? MensajeAcceso(string? estado) => estado switch
    {
        "credenciales" => "El correo o la contraseña son incorrectos. Revisa tus datos; si has realizado varios intentos, espera 15 minutos antes de volver a entrar.",
        "datos" => "Completa el correo y la contraseña con datos válidos.",
        "solicitud" => "La solicitud venció. Actualiza la página e inténtalo de nuevo.",
        "red" => "No pudimos completar la solicitud. Comprueba tu conexión e inténtalo de nuevo.",
        "conexion" => "No pudimos conectar con el servicio de acceso. Tu contraseña no se ha comprobado. Inténtalo de nuevo cuando se restablezca la conexión.",
        "servicio" => "El servicio no está disponible en este momento. Inténtalo nuevamente en unos minutos.",
        "intentos" => "Demasiados intentos. Espera un minuto antes de volver a intentar.",
        "salida" => "Tu sesión se cerró correctamente.",
        _ => null
    };
}
