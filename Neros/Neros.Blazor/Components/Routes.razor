@using Neros.Blazor.Components.Features.Sistema

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Features.Sistema.PaginaNoEncontrada)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <VistaAccesoDenegado />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>
